# Optional email-alert ingestion
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# Optional: restrict alert ingestion to Naukri, e.g. naukri.com
IMAP_FROM=

# Optional local LLM
LLM_ENABLED=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional email digest (existing digest module)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
# Optional source-mailbox controls
IMAP_MAILBOX=INBOX
IMAP_UNSEEN_ONLY=true
